# Cargo build output, at the workspace root and in any standalone crate.
target/

# The showcase app is generated by `dioxus-showcase build`, so its sources are not
# checked in. Its Cargo.toml is the exception: keeping it tracked is what makes the
# example build against this workspace instead of the published crates.
/example/showcase/*
!/example/showcase/Cargo.toml

# macOS Finder metadata.
.DS_Store

# Local editor and agent caches.
/.serena/

# mdBook output for the docs site
docs-site/book/
